# Application Port & Environment
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL 17)
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/enterprise_tms?schema=public"

# Authentication Security (JWT)
JWT_ACCESS_SECRET="enterprise_tms_access_super_secret_jwt_key_example"
JWT_REFRESH_SECRET="enterprise_tms_refresh_super_secret_jwt_key_example"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration (comma-separated origins)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
