generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// 1. ORGANIZATIONS & TENANCY
// ----------------------------------------------------
model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  email     String?
  phone     String?
  address   String?
  timezone  String   @default("UTC")
  currency  String   @default("USD")
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  customers       Customer[]
  carriers        Carrier[]
  vehicles        Vehicle[]
  drivers         Driver[]
  locations       Location[]
  transportOrders TransportOrder[]
  routes          Route[]
  loadPlans       LoadPlan[]
  geofences       Geofence[]
  facilities      Facility[]
  documents       Document[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  analyticsData   AnalyticsData[]

  @@map("organizations")
}

// ----------------------------------------------------
// 2. USERS, ROLES & PERMISSIONS (RBAC)
// ----------------------------------------------------
model User {
  id             String    @id @default(uuid())
  organizationId String
  firstName      String
  lastName       String
  email          String    @unique
  phone          String?
  passwordHash   String
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles     UserRole[]
  createdOrders TransportOrder[] @relation("OrderCreatedBy")
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique // SUPER_ADMIN, TMS_ADMIN, OPERATIONS_MANAGER, TRANSPORT_PLANNER, DISPATCHER, FLEET_MANAGER, DRIVER, CARRIER, CUSTOMER, FINANCE_MANAGER, COMPLIANCE_MANAGER, SUPPORT_AGENT, ANALYST
  description String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. orders:create, shipments:read, vehicles:update
  module      String // orders, shipments, fleet, dispatch, billing, etc.
  action      String // create, read, update, delete, approve
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ----------------------------------------------------
// 3. MASTER DATA & LOCATIONS
// ----------------------------------------------------
model LocationType {
  id          String     @id @default(uuid())
  name        String     @unique // WAREHOUSE, CUSTOMER, DEPOT, PORT, HUB, PICKUP, DELIVERY
  description String?
  locations   Location[]

  @@map("location_types")
}

model Location {
  id             String   @id @default(uuid())
  organizationId String
  locationTypeId String
  name           String
  address        String?
  city           String
  state          String?
  country        String   @default("USA")
  postalCode     String?
  latitude       Float
  longitude      Float
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationType LocationType @relation(fields: [locationTypeId], references: [id])

  originOrders       TransportOrder[] @relation("OrderOrigin")
  destinationOrders  TransportOrder[] @relation("OrderDestination")
  originRoutes       Route[]          @relation("RouteOrigin")
  destinationRoutes  Route[]          @relation("RouteDestination")
  carrierRatesOrigin CarrierRate[]    @relation("CarrierRateOrigin")
  carrierRatesDest   CarrierRate[]    @relation("CarrierRateDest")
  routeStops         RouteStop[]

  @@index([organizationId])
  @@map("locations")
}

model VehicleType {
  id          String    @id @default(uuid())
  code        String    @unique // SEMI_TRAILER, FLATBED, BOX_TRUCK, REEFER, VAN
  name        String
  description String?
  vehicles    Vehicle[]

  @@map("vehicle_types")
}

model CargoType {
  id            String         @id @default(uuid())
  name          String         @unique // DRY, REFRIGERATED, HAZMAT, LIQUID, OVERSIZED
  description   String?
  orderItems    OrderItem[]
  shipmentItems ShipmentItem[]

  @@map("cargo_types")
}

model PackageType {
  id            String         @id @default(uuid())
  name          String         @unique // PALLET, BOX, CRATE, DRUM, CONTAINER
  description   String?
  orderItems    OrderItem[]
  shipmentItems ShipmentItem[]

  @@map("package_types")
}

// ----------------------------------------------------
// 4. CUSTOMERS & CARRIERS
// ----------------------------------------------------
model Customer {
  id              String   @id @default(uuid())
  organizationId  String
  customerCode    String   @unique
  companyName     String
  contactName     String?
  email           String
  phone           String?
  billingAddress  String?
  shippingAddress String?
  creditLimit     Float    @default(50000)
  paymentTerms    String   @default("NET_30")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transportOrders TransportOrder[]
  shipments       Shipment[]
  invoices        Invoice[]

  @@index([organizationId])
  @@map("customers")
}

model Carrier {
  id             String   @id @default(uuid())
  organizationId String
  carrierCode    String   @unique
  companyName    String
  contactName    String?
  email          String
  phone          String?
  address        String?
  taxNumber      String?
  rating         Float    @default(5.0)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  carrierContracts CarrierContract[]
  carrierRates     CarrierRate[]
  carrierDocuments CarrierDocument[]
  shipments        Shipment[]
  dispatches       Dispatch[]
  tenderRequests   TenderRequest[]

  @@index([organizationId])
  @@map("carriers")
}

model CarrierContract {
  id             String   @id @default(uuid())
  carrierId      String
  contractNumber String   @unique
  startDate      DateTime
  endDate        DateTime
  status         String   @default("ACTIVE")

  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@map("carrier_contracts")
}

model CarrierRate {
  id                    String   @id @default(uuid())
  carrierId             String
  originLocationId      String
  destinationLocationId String
  baseRate              Float
  rateType              String   @default("PER_KM") // PER_KM, FLAT, PER_KG
  validFrom             DateTime
  validTo               DateTime
  status                String   @default("ACTIVE")

  carrier        Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  originLocation Location @relation("CarrierRateOrigin", fields: [originLocationId], references: [id])
  destLocation   Location @relation("CarrierRateDest", fields: [destinationLocationId], references: [id])

  @@map("carrier_rates")
}

model CarrierDocument {
  id           String    @id @default(uuid())
  carrierId    String
  documentType String
  fileUrl      String
  expiryDate   DateTime?
  status       String    @default("VERIFIED")

  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@map("carrier_documents")
}

// ----------------------------------------------------
// 5. FLEET & DRIVERS
// ----------------------------------------------------
model Vehicle {
  id               String    @id @default(uuid())
  organizationId   String
  vehicleTypeId    String
  vehicleNumber    String    @unique
  make             String
  model            String
  year             Int
  capacityWeight   Float // kg
  capacityVolume   Float // m3
  fuelType         String    @default("DIESEL")
  status           String    @default("AVAILABLE") // AVAILABLE, ASSIGNED, IN_TRANSIT, MAINTENANCE, OUT_OF_SERVICE
  currentLatitude  Float?
  currentLongitude Float?
  currentSpeed     Float?    @default(0)
  lastLocationAt   DateTime?
  createdAt        DateTime  @default(now())

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicleType        VehicleType          @relation(fields: [vehicleTypeId], references: [id])
  vehicleDocuments   VehicleDocument[]
  maintenanceRecords VehicleMaintenance[]
  driverAssignments  DriverAssignment[]
  shipments          Shipment[]
  dispatches         Dispatch[]
  trackingEvents     TrackingEvent[]

  @@index([organizationId])
  @@index([status])
  @@map("vehicles")
}

model VehicleDocument {
  id           String   @id @default(uuid())
  vehicleId    String
  documentType String // REGISTRATION, INSURANCE, POLLUTION, FITNESS
  fileUrl      String
  expiryDate   DateTime
  status       String   @default("ACTIVE")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_documents")
}

model VehicleMaintenance {
  id              String    @id @default(uuid())
  vehicleId       String
  serviceDate     DateTime
  serviceType     String // ROUTINE, ENGINE, TIRES, BRAKES, INSPECTION
  cost            Float
  status          String    @default("COMPLETED")
  nextServiceDate DateTime?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_maintenance")
}

model Driver {
  id               String   @id @default(uuid())
  organizationId   String
  employeeCode     String   @unique
  firstName        String
  lastName         String
  phone            String
  email            String?
  licenseNumber    String   @unique
  licenseExpiry    DateTime
  status           String   @default("AVAILABLE") // AVAILABLE, ON_TRIP, OFF_DUTY, SUSPENDED
  currentLatitude  Float?
  currentLongitude Float?
  createdAt        DateTime @default(now())

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  driverDocuments   DriverDocument[]
  driverAssignments DriverAssignment[]
  shipments         Shipment[]
  dispatches        Dispatch[]

  @@index([organizationId])
  @@index([status])
  @@map("drivers")
}

model DriverDocument {
  id           String   @id @default(uuid())
  driverId     String
  documentType String // LICENSE, MEDICAL, BACKGROUND_CHECK
  fileUrl      String
  expiryDate   DateTime
  status       String   @default("ACTIVE")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_documents")
}

model DriverAssignment {
  id        String    @id @default(uuid())
  driverId  String
  vehicleId String
  startDate DateTime  @default(now())
  endDate   DateTime?
  status    String    @default("ACTIVE")

  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("driver_assignments")
}

// ----------------------------------------------------
// 6. TRANSPORT ORDERS & SHIPMENTS
// ----------------------------------------------------
model TransportOrder {
  id                    String   @id @default(uuid())
  organizationId        String
  customerId            String
  orderNumber           String   @unique
  priority              String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status                String   @default("SUBMITTED") // DRAFT, SUBMITTED, CONFIRMED, PLANNED, DISPATCHED, IN_TRANSIT, DELIVERED, CANCELLED
  requestedPickupDate   DateTime
  requestedDeliveryDate DateTime
  originLocationId      String
  destinationLocationId String
  totalWeight           Float    @default(0) // kg
  totalVolume           Float    @default(0) // m3
  specialInstructions   String?
  createdBy             String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer            Customer     @relation(fields: [customerId], references: [id])
  originLocation      Location     @relation("OrderOrigin", fields: [originLocationId], references: [id])
  destinationLocation Location     @relation("OrderDestination", fields: [destinationLocationId], references: [id])
  createdByUser       User         @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  orderItems          OrderItem[]
  shipments           Shipment[]

  @@index([organizationId])
  @@index([status])
  @@index([customerId])
  @@map("transport_orders")
}

model OrderItem {
  id               String  @id @default(uuid())
  transportOrderId String
  description      String
  quantity         Int     @default(1)
  weight           Float // kg
  volume           Float // m3
  packageTypeId    String
  cargoTypeId      String
  fragile          Boolean @default(false)
  hazardous        Boolean @default(false)

  transportOrder TransportOrder @relation(fields: [transportOrderId], references: [id], onDelete: Cascade)
  packageType    PackageType    @relation(fields: [packageTypeId], references: [id])
  cargoType      CargoType      @relation(fields: [cargoTypeId], references: [id])

  @@map("order_items")
}

model Shipment {
  id               String    @id @default(uuid())
  shipmentNumber   String    @unique
  transportOrderId String
  customerId       String
  carrierId        String?
  vehicleId        String?
  driverId         String?
  routeId          String?
  status           String    @default("PLANNED") // PLANNED, ASSIGNED, DISPATCHED, IN_TRANSIT, DELIVERED, CANCELLED
  plannedPickup    DateTime?
  actualPickup     DateTime?
  plannedDelivery  DateTime?
  actualDelivery   DateTime?
  totalWeight      Float     @default(0)
  totalVolume      Float     @default(0)
  createdAt        DateTime  @default(now())

  transportOrder TransportOrder @relation(fields: [transportOrderId], references: [id], onDelete: Cascade)
  customer       Customer       @relation(fields: [customerId], references: [id])
  carrier        Carrier?       @relation(fields: [carrierId], references: [id])
  vehicle        Vehicle?       @relation(fields: [vehicleId], references: [id])
  driver         Driver?        @relation(fields: [driverId], references: [id])
  route          Route?         @relation(fields: [routeId], references: [id])

  shipmentItems   ShipmentItem[]
  loadPlanItems   LoadPlanItem[]
  dispatches      Dispatch[]
  tenderRequests  TenderRequest[]
  trackingEvents  TrackingEvent[]
  geofenceEvents  GeofenceEvent[]
  appointments    Appointment[]
  proofOfDelivery ProofOfDelivery?
  lorryReceipt    LorryReceipt?
  claims          Claim[]
  invoices        Invoice[]

  @@index([status])
  @@index([customerId])
  @@index([carrierId])
  @@index([vehicleId])
  @@index([driverId])
  @@map("shipments")
}

model ShipmentItem {
  id            String  @id @default(uuid())
  shipmentId    String
  description   String
  quantity      Int     @default(1)
  weight        Float
  volume        Float
  packageTypeId String
  cargoTypeId   String
  fragile       Boolean @default(false)
  hazardous     Boolean @default(false)

  shipment    Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  packageType PackageType @relation(fields: [packageTypeId], references: [id])
  cargoType   CargoType   @relation(fields: [cargoTypeId], references: [id])

  @@map("shipment_items")
}

// ----------------------------------------------------
// 7. ROUTE, LOAD PLANNING & DISPATCH
// ----------------------------------------------------
model Route {
  id                    String   @id @default(uuid())
  organizationId        String
  routeNumber           String   @unique
  originLocationId      String
  destinationLocationId String
  totalDistance         Float // km
  estimatedDuration     Int // minutes
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  originLocation Location     @relation("RouteOrigin", fields: [originLocationId], references: [id])
  destLocation   Location     @relation("RouteDestination", fields: [destinationLocationId], references: [id])
  routeStops     RouteStop[]
  shipments      Shipment[]

  @@index([organizationId])
  @@map("routes")
}

model RouteStop {
  id               String    @id @default(uuid())
  routeId          String
  locationId       String
  sequenceNo       Int
  arrivalTime      DateTime?
  departureTime    DateTime?
  distanceFromPrev Float     @default(0) // km

  route    Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id])

  @@map("route_stops")
}

model LoadPlan {
  id             String   @id @default(uuid())
  organizationId String
  planNumber     String   @unique
  planDate       DateTime @default(now())
  status         String   @default("DRAFT") // DRAFT, OPTIMIZED, CONFIRMED
  createdAt      DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loadPlanItems LoadPlanItem[]

  @@index([organizationId])
  @@map("load_plans")
}

model LoadPlanItem {
  id         String @id @default(uuid())
  loadPlanId String
  shipmentId String
  weight     Float
  volume     Float

  loadPlan LoadPlan @relation(fields: [loadPlanId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("load_plan_items")
}

model Dispatch {
  id                     String    @id @default(uuid())
  dispatchNumber         String    @unique
  shipmentId             String
  vehicleId              String?
  driverId               String?
  carrierId              String?
  dispatchTime           DateTime  @default(now())
  status                 String    @default("ASSIGNED") // PLANNED, ASSIGNED, DISPATCHED, DRIVER_ACCEPTED, PICKUP, IN_TRANSIT, DELIVERY, COMPLETED
  completeTime           DateTime?
  startOdometer          Float?    @default(0)
  endOdometer            Float?    @default(0)
  totalKm                Float?    @default(0)
  fuelLitres             Float?    @default(0)
  tripExpenseTotal       Float?    @default(0)
  driverSettlementAmount Float?    @default(0)
  closureStatus          String?   @default("OPEN") // OPEN, SUBMITTED, APPROVED, SETTLED

  shipment     Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])
  driver       Driver?       @relation(fields: [driverId], references: [id])
  carrier      Carrier?      @relation(fields: [carrierId], references: [id])
  tripExpenses TripExpense[]

  @@index([status])
  @@map("dispatches")
}

model LorryReceipt {
  id               String    @id @default(uuid())
  lrNumber         String    @unique // e.g. LR-980124
  shipmentId       String    @unique
  ewayBillNumber   String?
  ewayBillExpiry   DateTime?
  consignorName    String
  consignorAddress String?
  consigneeName    String
  consigneeAddress String?
  declaredValue    Float     @default(0)
  billingTerms     String    @default("TO_BE_BILLED") // PAID, TO_PAY, TO_BE_BILLED
  status           String    @default("ISSUED") // ISSUED, IN_TRANSIT, DELIVERED, CANCELLED
  issuedAt         DateTime  @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("lorry_receipts")
}

model TripExpense {
  id          String   @id @default(uuid())
  dispatchId  String
  expenseType String // FUEL, DRIVER_ALLOWANCE, TOLL, TYRE, MAINTENANCE, MISC
  amount      Float
  litres      Float?
  odometer    Float?
  description String?
  receiptUrl  String?
  status      String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@map("trip_expenses")
}

model AccountingSync {
  id             String   @id @default(uuid())
  organizationId String
  entityType     String // INVOICE, PAYMENT, EXPENSE, SETTLEMENT
  entityId       String
  targetSystem   String   @default("TALLY_PRIME") // TALLY_PRIME, SAP_S4HANA, ZOHO_BOOKS
  voucherNumber  String
  voucherType    String // SALES_VOUCHER, PURCHASE_VOUCHER, PAYMENT_VOUCHER
  amount         Float
  syncStatus     String   @default("SYNCED") // SYNCED, PENDING, FAILED
  payloadJson    String?
  syncedAt       DateTime @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("accounting_syncs")
}

model TenderRequest {
  id            String    @id @default(uuid())
  shipmentId    String
  carrierId     String
  tenderDate    DateTime  @default(now())
  requestedRate Float
  responseDate  DateTime?
  status        String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED
  remarks       String?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  carrier  Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@map("tender_requests")
}

// ----------------------------------------------------
// 8. LIVE TRACKING & GEOFENCING
// ----------------------------------------------------
model Geofence {
  id             String @id @default(uuid())
  organizationId String
  name           String
  latitude       Float
  longitude      Float
  radius         Float // meters
  type           String @default("WAREHOUSE") // WAREHOUSE, CUSTOMER, DEPOT, TOLL

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  geofenceEvents GeofenceEvent[]

  @@index([organizationId])
  @@map("geofences")
}

model GeofenceEvent {
  id         String   @id @default(uuid())
  shipmentId String
  geofenceId String
  eventType  String // ENTERED, EXITED, DWELL_TIME_EXCEEDED
  eventTime  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@map("geofence_events")
}

model TrackingEvent {
  id         String   @id @default(uuid())
  shipmentId String
  vehicleId  String?
  latitude   Float
  longitude  Float
  speed      Float    @default(0)
  heading    Float    @default(0)
  eventType  String   @default("GPS_UPDATE") // GPS_UPDATE, STOP, DELAY, DEVIATION, BREAKDOWN
  timestamp  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([shipmentId])
  @@index([timestamp])
  @@map("tracking_events")
}

// ----------------------------------------------------
// 9. FACILITIES, DOCKS & APPOINTMENTS
// ----------------------------------------------------
model Facility {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  address        String?
  type           String  @default("WAREHOUSE")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  docks        Dock[]
  appointments Appointment[]

  @@index([organizationId])
  @@map("facilities")
}

model Dock {
  id         String @id @default(uuid())
  facilityId String
  name       String
  type       String @default("INBOUND") // INBOUND, OUTBOUND, BOTH
  status     String @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE

  facility     Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("docks")
}

model Appointment {
  id              String    @id @default(uuid())
  shipmentId      String
  facilityId      String
  dockId          String?
  appointmentDate DateTime
  timeSlot        String // e.g. "09:00 - 10:00"
  status          String    @default("REQUESTED") // REQUESTED, SCHEDULED, CONFIRMED, CHECKED_IN, COMPLETED, CANCELLED
  checkInTime     DateTime?
  checkOutTime    DateTime?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  dock     Dock?    @relation(fields: [dockId], references: [id])

  @@map("appointments")
}

// ----------------------------------------------------
// 10. PROOF OF DELIVERY (POD)
// ----------------------------------------------------
model ProofOfDelivery {
  id              String   @id @default(uuid())
  shipmentId      String   @unique
  receiverName    String
  receiverContact String?
  otp             String?
  signatureUrl    String? // Base64 or URL
  photoUrl        String?
  deliveredAt     DateTime @default(now())
  latitude        Float?
  longitude       Float?
  status          String   @default("VERIFIED") // PENDING, SUBMITTED, VERIFIED, REJECTED
  remarks         String?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("proof_of_delivery")
}

// ----------------------------------------------------
// 11. DOCUMENTS & COMPLIANCE
// ----------------------------------------------------
model DocumentType {
  id        String     @id @default(uuid())
  name      String     @unique // BOL, INVOICE, INSURANCE, PERMIT, POD, INCIDENT
  category  String     @default("GENERAL") // GENERAL, VEHICLE, DRIVER, CARRIER, SHIPMENT
  documents Document[]

  @@map("document_types")
}

model Document {
  id             String    @id @default(uuid())
  organizationId String
  entityType     String // SHIPMENT, VEHICLE, DRIVER, CARRIER, CLAIM
  entityId       String
  documentTypeId String
  title          String
  fileName       String
  fileUrl        String
  version        Int       @default(1)
  expiryDate     DateTime?
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("documents")
}

// ----------------------------------------------------
// 12. CLAIMS MANAGEMENT
// ----------------------------------------------------
model Claim {
  id          String   @id @default(uuid())
  shipmentId  String
  claimNumber String   @unique
  type        String // DAMAGE, SHORTAGE, LOSS, DELAY
  description String
  amount      Float
  status      String   @default("OPEN") // OPEN, UNDER_REVIEW, APPROVED, REJECTED, SETTLED, CLOSED
  createdAt   DateTime @default(now())

  shipment   Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  claimItems ClaimItem[]

  @@map("claims")
}

model ClaimItem {
  id          String @id @default(uuid())
  claimId     String
  description String
  quantity    Int    @default(1)
  amount      Float

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@map("claim_items")
}

// ----------------------------------------------------
// 13. BILLING, INVOICING & PAYMENTS
// ----------------------------------------------------
model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  shipmentId    String
  customerId    String
  invoiceDate   DateTime @default(now())
  dueDate       DateTime
  totalAmount   Float
  taxAmount     Float    @default(0)
  status        String   @default("ISSUED") // DRAFT, ISSUED, PAID, PARTIAL, OVERDUE, CANCELLED
  createdAt     DateTime @default(now())

  shipment     Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]
  payments     Payment[]

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String @id @default(uuid())
  invoiceId   String
  description String
  amount      Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  amount        Float
  paymentDate   DateTime @default(now())
  paymentMethod String // WIRE, CREDIT_CARD, ACH, CHEQUE
  transactionId String?
  status        String   @default("COMPLETED") // COMPLETED, PENDING, FAILED

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ----------------------------------------------------
// 14. NOTIFICATIONS, AUDIT & ANALYTICS
// ----------------------------------------------------
model Notification {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  title          String
  message        String
  type           String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  channel        String   @default("IN_APP") // IN_APP, EMAIL, SMS, PUSH
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String // e.g. SHIPMENT_CREATED, USER_ROLE_CHANGED, DISPATCH_ASSIGNED
  module         String // shipments, users, fleet, billing, etc.
  entityType     String
  entityId       String
  oldValue       String?
  newValue       String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model AnalyticsData {
  id             String   @id @default(uuid())
  organizationId String
  metricType     String // KPI, DAILY_OPS, FINANCIAL, EMISSIONS
  metricKey      String // OTD_PERCENT, TRANSIT_TIME_AVG, FUEL_CONSUMPTION, REVENUE
  metricValue    Float
  periodDate     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([metricKey])
  @@map("analytics_data")
}
