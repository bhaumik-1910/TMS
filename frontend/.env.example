# Frontend Development Server Port
VITE_PORT=5173

# Application Title
VITE_APP_TITLE=APEX Transport Management System

# Backend API Base URL (Leave as http://localhost:3000 or empty if using Vite proxy)
VITE_API_BASE_URL=http://localhost:3000

# WebSocket / Socket.io Server URL
VITE_SOCKET_URL=http://localhost:3000

# Maps & Geolocation API Key (optional)
VITE_MAPS_API_KEY=your_maps_api_key_here
